# Keep "demo" for the existing prototype. Set to "production" to enable real authentication.
NEXT_PUBLIC_APP_MODE=demo
# In production mode, this MUST use the same hostname you open the frontend at (e.g. both
# "localhost" or both "127.0.0.1") — the backend's refresh-token cookie is SameSite=Strict and
# is scoped per-hostname, so a mismatched pair (frontend=localhost, backend=127.0.0.1 or vice
# versa) silently breaks login/refresh/session-restore. If "localhost" is unreliable in your
# local setup (e.g. it resolves to the IPv6 loopback while Docker only publishes the backend
# port on IPv4), use 127.0.0.1 for both the frontend URL and this value instead.
NEXT_PUBLIC_API_URL=http://localhost:8080
